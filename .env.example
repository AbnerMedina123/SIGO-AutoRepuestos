# Copia este archivo como `.env` y rellena los valores de tu proyecto Supabase.
# Estos valores también deben configurarse en Netlify (Site settings ->
# Environment variables) para el despliegue en producción.
#
# La publishable key es segura para el navegador (solo hace lo que permita RLS).
# NUNCA pongas aquí la service_role key.
VITE_SUPABASE_URL=https://TU-PROYECTO.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxx

# (Opcional) Clave pública del sitio de Cloudflare Turnstile (CAPTCHA).
# Si se define, el registro y el login mostrarán la verificación anti-bots.
# Si se deja vacía, el CAPTCHA se omite. La clave "secret" NO va aquí: se
# configura en Supabase -> Authentication -> Attack Protection.
VITE_TURNSTILE_SITE_KEY=
